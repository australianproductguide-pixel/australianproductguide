{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/assets/**/*.css"
    },
    "api/continuous-index.js": {
      "includeFiles": "public/assets/**/*.css"
    }
  },
  "git": {
    "deploymentEnabled": {
      "apg/*": false,
      "apg-*": false,
      "cost-control-*": false,
      "hotfix/*": false,
      "fix/*": false,
      "feature/*": false,
      "chore/*": false
    }
  },
  "routes": [
    { "src": "/mcp", "dest": "/api/mcp" },
    { "src": "/oauth/consent", "dest": "/api/oauth-consent" },
    { "src": "/.well-known/oauth-protected-resource/mcp", "dest": "/api/mcp-oauth-metadata" },
    { "src": "/.well-known/oauth-protected-resource", "dest": "/api/mcp-oauth-metadata" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/continuous-index" }
  ]
}
