{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/assets/**/*.css"
    },
    "api/p0-home-stage.js": {
      "includeFiles": "public/assets/**/*.css"
    }
  },
  "git": {
    "deploymentEnabled": {
      "apg/*": false,
      "apg-*": false,
      "cost-control-*": false,
      "hotfix/*": false,
      "fix/*": false,
      "feature/*": false,
      "chore/*": false
    }
  },
  "routes": [
    {
      "src": "/",
      "headers": {
        "Location": "/search/",
        "Cache-Control": "no-store, max-age=0",
        "X-APG-P0-Home-Availability": "TEMPORARY_SEARCH_REDIRECT"
      },
      "status": 307
    },
    { "src": "/__apg-p0-home-stage-20260901", "dest": "/api/p0-home-stage" },
    { "src": "/mcp", "dest": "/api/mcp" },
    { "src": "/oauth/consent", "dest": "/api/oauth-consent" },
    { "src": "/.well-known/oauth-protected-resource/mcp", "dest": "/api/mcp-oauth-metadata" },
    { "src": "/.well-known/oauth-protected-resource", "dest": "/api/mcp-oauth-metadata" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}
