{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "git": {
    "deploymentEnabled": {
      "apg/*": false,
      "apg-*": false,
      "cost-control-*": false,
      "hotfix/*": false,
      "fix/*": false,
      "feature/*": false,
      "chore/*": false
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}
