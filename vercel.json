{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "buildCommand": "node scripts/build-home-css-v128.js && npm run vercel-build",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/assets/**/*.css"
    },
    "api/home-assembly-diagnostic.js": {
      "includeFiles": "public/assets/**/*.css"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": ".+"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "apg/*": false,
      "apg-*": false,
      "cost-control-*": false,
      "hotfix/*": false,
      "fix/*": false,
      "feature/*": false,
      "chore/*": false
    }
  },
  "routes": [
    { "src": "/mcp", "dest": "/api/mcp" },
    { "src": "/oauth/consent", "dest": "/api/oauth-consent" },
    { "src": "/.well-known/oauth-protected-resource/mcp", "dest": "/api/mcp-oauth-metadata" },
    { "src": "/.well-known/oauth-protected-resource", "dest": "/api/mcp-oauth-metadata" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api" }
  ]
}
